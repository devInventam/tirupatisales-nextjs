	<script>

		var FilterTextBox = $("#txtSearch");
		var timer = null;
        FilterTextBox.on('keydown', function(e){
            clearTimeout(timer); 
            timer = setTimeout(SearchProduct, 800);
        });

		function ResetSearch()
		{
			$("#divSearch_Product").html("");
			var InnerHtml = '<li  class="dropdown-item" id="divSearch_NoData" style="display:none"><div style="display: flex;align-items: center;justify-content: center;"><span style="margin-left: 4px;font-size: 14px;font-weight: 600;"  class="search_text">No product found</span></div></li><li  class="dropdown-item" id="divSearch_Loading" style="display:none"><div style="display: flex;align-items: center;justify-content: center;"><img style="height: 16px;margin-right: 0;" class="search_img" src="https://www.tirupatisales.com/admin/spinner_large.gif"/><span style="font-size: 14px;font-weight: 600;" class="search_text">Please wait</span></div></li>';
			$("#divSearch_Product").html(InnerHtml);
		}

		function btnSearch_Click()
		{
			SearchProduct();
		}

		function SearchProduct()
		{
			ResetSearch();
			var SearchText = $("#txtSearch").val();
			$.ajax({   
			url:"https://www.tirupatisales.com/site/search/product",
			method:"POST",  
			data:{
				'SearchText':SearchText,
			},
			beforeSend:function(){
				$("#divSearch_Loading").show();
				$("#divSearch_NoData").hide();
			},
			success: function(response){ 
				var json = jQuery.parseJSON(response); 
				if(json.Products_Found == "False")
				{     
					$("#divSearch_Loading").hide();
					$("#divSearch_NoData").show();
				}    
				else
				{
					$("#divSearch_Loading").hide();
					$("#divSearch_NoData").hide();
					var result = json.Products;
					for(products in result)
					{
						var Slug = result[products].Slug;
						var Name = result[products].Name;
						var ImagePath = result[products].Image_Path;

						var tr = "<li class='dropdown-item'>";
						tr+= '<a href="https://www.tirupatisales.com/product/detail/'+Slug+'">';
						tr += "<div style='display: flex;align-items: center;'>";       
						tr+= '<img class="search_img" src="https://www.tirupatisales.com/'+ImagePath+'"/>' ;
						tr+= '<span class="search_text">'+Name+'</span>' ; 
						tr += "</div>";     
						tr +="</a>"      
						tr += "</li>";
						$('#divSearch_Product').append(tr);
					}
					
				}  
				
			},
			});
		}

		function btnCategory_Click(id)
		{
			id =  id.substring(4);
        	$.ajax({
            type: "POST",
            url : 'https://www.tirupatisales.com/category/list/for_menu',
            data:{
                'Product_Category_Id':id,
            },
            beforeSend:function(){
                
            },
                success: function(data){
					$(".cust-nav").removeClass("cust-nav-active");
                   $("#divSubCategory").html("");
				   $("#divSubCategory").html(data);
				   $("#menu"+id).addClass("cust-nav-active");
				   
                },

            });
		}

					
			btnCategory_Click('menu1');
		
	(function() {
        var $gallery = new SimpleLightbox('.gallery a', {});
    })();

	jQuery("#carousel").owlCarousel({
		autoplay: true,
		rewind: true, /* use rewind if you don't want loop */
		margin: 20,
		/*
		animateOut: 'fadeOut',
		animateIn: 'fadeIn',
		*/
		responsiveClass: true,
		autoHeight: true,
		autoplayTimeout: 7000,
		smartSpeed: 800,
		nav: true,
		dots:true,
		responsive: {
			0: {
			items: 1
			},

			600: {
			items: 1
			},

			1024: {
			items: 1
			},

			1366: {
			items: 1
			}
		}
	});
	</script>
